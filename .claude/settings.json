{
  "env": {
    "CARGO_TERM_COLOR": "always",
    "SECD_REQUIRE_BROWSER": "1",
    "SECD_REQUIRE_LINTERS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(scripts/check.sh:*)",
      "Bash(scripts/plan-contract.sh:*)",
      "Bash(scripts/build-ui.sh:*)",
      "Bash(scripts/install-hooks.sh:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo test:*)",
      "Bash(cargo build:*)",
      "Bash(cargo metadata:*)",
      "Bash(rustup show:*)",
      "Bash(shellcheck:*)",
      "Bash(actionlint:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)"
    ],
    "deny": [
      "Bash(scripts/k3s-apply.sh:*)",
      "Bash(scripts/publish-release.sh:*)",
      "Bash(gh release:*)",
      "Bash(docker push:*)",
      "Bash(podman push:*)",
      "Bash(cosign sign:*)",
      "Bash(secd run:*)",
      "Bash(secd gitea:*)",
      "Bash(secd git-credential:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.py"
          }
        ]
      }
    ]
  }
}
